# Load these with --config=ENV. Never commit real tokens.
TAP_CONFLUENCE_CLOUD_SITE_URL=https://example.atlassian.net/wiki
TAP_CONFLUENCE_CLOUD_EMAIL=your-email@example.test
TAP_CONFLUENCE_CLOUD_API_TOKEN=your-api-token
TAP_CONFLUENCE_CLOUD_PAGE_SIZE=100
TAP_CONFLUENCE_CLOUD_MAX_ATTACHMENT_BYTES=10485760
# Optional JSON arrays:
# TAP_CONFLUENCE_CLOUD_SPACE_IDS=["123"]
# TAP_CONFLUENCE_CLOUD_PAGE_IDS=["456"]
